def run_tests(csv_path, currently_testing): 
    df = pd.read_csv(csv_path)
    print(f"Running tests on {len(df)} code samples...\n")

    errors = []
    for index, row in df.iterrows():
        code = row['Code']
        desired_features = row['Features'].split(", ")

        print("Desired Features:")
        print(desired_features)

        print(f"Test Case {index + 1}:")

        print("Detected Features:")
        features = detectSMLFeatures(code)
        print(features)

        for f in features:
            if f not in desired_features:
                print(f"Error: Detected feature '{f}' not in desired features.")
                errors.append((index + 1))
        
        print("-" * 40)
    
    print ("FINAL ERRORS FOUND: ", errors)
    print ("Total Errors: ", len(errors))

